# Run ./scripts/create-local-env.sh to create a mode-600 .env with two
# independently generated tokens and their matching Azure-shaped hashes.
ApiKeys__Credentials__0__Id=koi-local-primary
ApiKeys__Credentials__0__Sha256=replace-with-the-first-token-sha256
ApiKeys__Credentials__0__Enabled=true
ApiKeys__Credentials__1__Id=koi-local-secondary
ApiKeys__Credentials__1__Sha256=replace-with-the-second-token-sha256
ApiKeys__Credentials__1__Enabled=true

# Plaintext local-only client tokens used by smoke-local.sh and API clients.
KOI_API_KEY_1=replace-with-a-256-bit-random-token
KOI_API_KEY_2=replace-with-an-independent-256-bit-random-token
KOI_PORT=7071

# Aggie Enterprise financial API settings. Keep real credentials only in the
# gitignored .env file. The test deployment configuration script reads the
# same names from .env.test.
Financial__ApiUrl=[External]
Financial__ConsumerKey=[External]
Financial__ConsumerSecret=[External]
Financial__TokenEndpoint=[External]
Financial__ScopeApp=KOI
Financial__ScopeEnv=Production

# Optional local export to the central Elastic OTLP collector. Keep real values
# only in the gitignored .env file.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://replace-with-collector-endpoint
# OTEL_EXPORTER_OTLP_HEADERS='Authorization=ApiKey replace-with-credential'
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# Program.cs supplies service.name, service.version, deployment.environment=local,
# and service.namespace. OTEL_RESOURCE_ATTRIBUTES may add other attributes;
# values for those required attributes are ignored.
