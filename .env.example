# Run ./scripts/create-local-env.sh to create a mode-600 .env with two
# independently generated tokens.
KOI_API_KEY_1_ID=koi-local-primary
KOI_API_KEY_1=replace-with-a-256-bit-random-token
KOI_API_KEY_2_ID=koi-local-secondary
KOI_API_KEY_2=replace-with-an-independent-256-bit-random-token
KOI_PORT=7071

# Optional local export to the central Elastic OTLP collector. Keep real values
# only in a gitignored .env or .env.test file.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://replace-with-collector-endpoint
# OTEL_EXPORTER_OTLP_HEADERS='Authorization=ApiKey replace-with-credential'
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_RESOURCE_ATTRIBUTES='service.name=koi,service.version=0.1.0,deployment.environment=local,service.namespace=ucdavis'

# OTEL_EXPORTER_OTLP_PROTOCOL is optional; the .NET SDK defaults to grpc.
# run-local.sh derives service.version and supplies the resource attributes above
# automatically unless OTEL_RESOURCE_ATTRIBUTES is explicitly set.
