# Copy to .env and replace both placeholder tokens with independent values
# produced by: openssl rand -base64 32
KOI_API_KEY_1_ID=koi-local-primary
KOI_API_KEY_1=replace-with-a-256-bit-random-token
KOI_API_KEY_2_ID=koi-local-secondary
KOI_API_KEY_2=replace-with-an-independent-256-bit-random-token
KOI_PORT=7071
